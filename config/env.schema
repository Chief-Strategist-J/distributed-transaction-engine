$schema: "https://json-schema.org/draft/2020-12/schema"
title: "EngineConfig"
type: "object"
required:
  - "server"
properties:
  server:
    type: "object"
    required:
      - "name"
      - "bind_address"
      - "admin_bind_address"
    properties:
      name:
        type: "string"
      bind_address:
        type: "string"
      admin_bind_address:
        type: "string"
      read_timeout_seconds:
        type: "integer"
        minimum: 1
      write_timeout_seconds:
        type: "integer"
        minimum: 1
      idle_timeout_seconds:
        type: "integer"
        minimum: 1
      shutdown_deadline_seconds:
        type: "integer"
        minimum: 1
  database:
    type: "object"
    properties:
      host:
        type: "string"
      port:
        type: "string"
      user:
        type: "string"
      password:
        type: "string"
      name:
        type: "string"
      sslmode:
        type: "string"
      max_open_conns:
        type: "integer"
        minimum: 1
      max_idle_conns:
        type: "integer"
        minimum: 1
      conn_max_lifetime_minutes:
        type: "integer"
        minimum: 1
      migrations_dir:
        type: "string"
  poller:
    type: "object"
    properties:
      worker_id:
        type: "string"
      lease_duration_seconds:
        type: "integer"
        minimum: 1
      poll_interval_millis:
        type: "integer"
        minimum: 1
  kafka:
    type: "object"
    properties:
      brokers:
        type: "string"
  endpoints:
    type: "object"
    properties:
      base_path:
        type: "string"
