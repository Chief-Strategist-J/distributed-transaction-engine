:8080 {
    # Application routes
    handle /api/* {
        reverse_proxy app:8080
    }

    # Health probes
    handle /health/* {
        reverse_proxy app:8081
    }

    # Observability Dashboards
    handle_path /grafana/* {
        reverse_proxy grafana:3000
    }

    handle {
        respond "Infrastructure & Ingress Proxy Ready" 200
    }
}
